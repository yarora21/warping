digraph schema {
graph [rankdir=LR, bgcolor="white", pad=0.35, nodesep=0.45, ranksep=1.0, fontname="Helvetica", fontsize=24, label="Northstar · Implemented database schema", labelloc=t];
node [shape=plain, fontname="Helvetica"];
edge [color="#94a3b8", fontname="Helvetica", fontsize=9, arrowsize=0.7];
employees [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>employees</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">name text</TD></TR><TR><TD ALIGN="LEFT">email text UNIQUE</TD></TR></TABLE>>];
departments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>departments</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">name text UNIQUE</TD></TR></TABLE>>];
groups [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>groups</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">name text UNIQUE</TD></TR></TABLE>>];
employments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>employments</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">employee_id text FK</TD></TR><TR><TD ALIGN="LEFT">UNIQUE (id, employee_id)</TD></TR></TABLE>>];
employment_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>employment_versions</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">employment_id text FK*</TD></TR><TR><TD ALIGN="LEFT">employee_id text FK*</TD></TR><TR><TD ALIGN="LEFT">+ revision fields</TD></TR></TABLE>>];
employee_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>employee_versions</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">employment_id text FK</TD></TR><TR><TD ALIGN="LEFT">employment_type text</TD></TR><TR><TD ALIGN="LEFT">country text</TD></TR><TR><TD ALIGN="LEFT">state text NULL</TD></TR><TR><TD ALIGN="LEFT">department_id text FK</TD></TR><TR><TD ALIGN="LEFT">manager_id text FK NULL</TD></TR><TR><TD ALIGN="LEFT">+ revision fields</TD></TR></TABLE>>];
group_memberships [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>group_memberships</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">employment_id text FK</TD></TR><TR><TD ALIGN="LEFT">group_id text FK</TD></TR><TR><TD ALIGN="LEFT">+ revision fields</TD></TR></TABLE>>];
assignment_categories [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>assignment_categories</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">name text</TD></TR><TR><TD ALIGN="LEFT">cardinality text</TD></TR><TR><TD ALIGN="LEFT">is_single boolean GENERATED</TD></TR><TR><TD ALIGN="LEFT">UNIQUE (id, is_single)</TD></TR></TABLE>>];
policies [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>policies</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">category_id text FK</TD></TR><TR><TD ALIGN="LEFT">UNIQUE (id, category_id)</TD></TR></TABLE>>];
policy_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>policy_versions</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">policy_id text FK</TD></TR><TR><TD ALIGN="LEFT">name text</TD></TR><TR><TD ALIGN="LEFT">description text</TD></TR><TR><TD ALIGN="LEFT">+ revision fields</TD></TR></TABLE>>];
assignment_rules [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>assignment_rules</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR></TABLE>>];
assignment_rule_versions [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>assignment_rule_versions</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">rule_id text FK</TD></TR><TR><TD ALIGN="LEFT">policy_id text FK</TD></TR><TR><TD ALIGN="LEFT">name text</TD></TR><TR><TD ALIGN="LEFT">priority integer &gt;= 0</TD></TR><TR><TD ALIGN="LEFT">conditions jsonb</TD></TR><TR><TD ALIGN="LEFT">+ revision fields</TD></TR></TABLE>>];
employee_assignment_overrides [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dbeafe"><B>employee_assignment_overrides</B></TD></TR><TR><TD ALIGN="LEFT">id text PK</TD></TR><TR><TD ALIGN="LEFT">employment_id text FK</TD></TR><TR><TD ALIGN="LEFT">category_id text FK*</TD></TR><TR><TD ALIGN="LEFT">policy_id text FK* NULL</TD></TR><TR><TD ALIGN="LEFT">is_single boolean FK*</TD></TR><TR><TD ALIGN="LEFT">action text</TD></TR><TR><TD ALIGN="LEFT">reason text</TD></TR><TR><TD ALIGN="LEFT">+ revision fields (reason replaces change_reason)</TD></TR></TABLE>>];
employee_assignments [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dcfce7"><B>employee_assignments</B></TD></TR><TR><TD ALIGN="LEFT">id uuid PK</TD></TR><TR><TD ALIGN="LEFT">employee_id text FK</TD></TR><TR><TD ALIGN="LEFT">category_id text FK*</TD></TR><TR><TD ALIGN="LEFT">policy_id text FK*</TD></TR><TR><TD ALIGN="LEFT">is_single boolean FK*</TD></TR><TR><TD ALIGN="LEFT">valid_during daterange</TD></TR><TR><TD ALIGN="LEFT">explanation jsonb</TD></TR></TABLE>>];
reconciliation_runs [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dcfce7"><B>reconciliation_runs</B></TD></TR><TR><TD ALIGN="LEFT">id uuid PK</TD></TR><TR><TD ALIGN="LEFT">created_at timestamptz</TD></TR><TR><TD ALIGN="LEFT">actor text</TD></TR><TR><TD ALIGN="LEFT">reason text</TD></TR><TR><TD ALIGN="LEFT">employee_ids jsonb</TD></TR></TABLE>>];
assignment_changes [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="7" COLOR="#94a3b8"><TR><TD BGCOLOR="#dcfce7"><B>assignment_changes</B></TD></TR><TR><TD ALIGN="LEFT">id bigint IDENTITY PK</TD></TR><TR><TD ALIGN="LEFT">run_id uuid FK</TD></TR><TR><TD ALIGN="LEFT">action text</TD></TR><TR><TD ALIGN="LEFT">snapshot jsonb</TD></TR></TABLE>>];
employments -> employees [label="employee_id"];
employment_versions -> employments [label="employment_id + employee_id"];
employee_versions -> employments [label="employment_id"];
employee_versions -> departments [label="department_id"];
employee_versions -> employees [label="manager_id (optional)"];
group_memberships -> employments [label="employment_id"];
group_memberships -> groups [label="group_id"];
policies -> assignment_categories [label="category_id"];
policy_versions -> policies [label="policy_id"];
assignment_rule_versions -> assignment_rules [label="rule_id"];
assignment_rule_versions -> policies [label="policy_id"];
employee_assignment_overrides -> employments [label="employment_id"];
employee_assignment_overrides -> assignment_categories [label="category_id + is_single"];
employee_assignment_overrides -> policies [label="policy_id + category_id (optional)"];
employee_assignments -> employees [label="employee_id"];
employee_assignments -> assignment_categories [label="category_id + is_single"];
employee_assignments -> policies [label="policy_id + category_id"];
assignment_changes -> reconciliation_runs [label="run_id"];
}
