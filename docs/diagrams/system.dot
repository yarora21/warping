digraph system {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.4, ranksep=0.55, fontname="Helvetica", label="Northstar · System architecture", labelloc=t, fontsize=24];
  node [shape=box, style="rounded,filled", fillcolor="#eff6ff", color="#93b4da", fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
  edge [color="#64748b", fontname="Helvetica", fontsize=10];
  user [label="HR user\nLocal demo · fictional actor", fillcolor="#f1f5f9"];
  ui [label="React 19 + TypeScript\nPeople · Policies · Assignments\nProfiles, editors, previews and explanations"];
  web [label="Nginx · localhost:5180\nServes built Vite assets\nProxies /api/* to api:8000"];
  user -> ui;
  web -> ui [label="static assets"];
  ui -> web [label="HTTP /api/*"];
  subgraph cluster_api {
    label="FastAPI service · localhost:8010 → container:8000";
    color="#cbd5e1"; style=rounded; fontname="Helvetica";
    routes [label="Typed HTTP routes\nmain.py + schemas.py"];
    reads [label="Read models\nDirectory / catalog / stored assignments\nEmployee history and exceptions"];
    preview [label="Preview\nLoad inputs + plan in memory\nReturn impact and coverage gaps"];
    save [label="Save\nCompany advisory transaction lock\nReload inputs + revalidate plan"];
    resolver [label="Pure resolver + field registry\nPoint resolution and complete timelines\nRules + employee facts + manual overrides", fillcolor="#ecfdf5", color="#86bfa5"];
    reconcile [label="Atomic reconciliation\nPersist input revisions · resolve timelines\nReject required gaps · diff intervals/evidence\nWrite assignments + change history"];
    routes -> reads;
    routes -> preview;
    routes -> save;
    preview -> resolver [label="before / after"];
    save -> resolver [label="replan"];
    save -> reconcile;
    reconcile -> resolver [label="calculate desired results"];
  }
  web -> routes [label="internal proxy"];
  db [shape=cylinder, label="PostgreSQL 17\nDated inputs + catalogs\nMaterialized assignments + evidence/history\nPersistent policy_data volume", fillcolor="#fff7ed", color="#e9b780"];
  reads -> db [label="SELECT"];
  preview -> db [label="snapshot reads only"];
  save -> db [label="lock + input reads"];
  reconcile -> db [label="one transaction"];
  ops [label="Explicit seed / reconcile commands", fillcolor="#f1f5f9"];
  migrations [label="Alembic migrations\nRun before API startup", fillcolor="#f1f5f9"];
  ops -> save [label="same lock / transaction path"];
  migrations -> db [label="DDL + constraints"];
  types [label="OpenAPI → generated TypeScript\nDevelopment-time contract", fillcolor="#f1f5f9"];
  routes -> types [style=dashed];
  types -> ui [style=dashed];
}
