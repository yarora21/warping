{
  "name": "northstar-policy-assignments",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "types": "openapi-typescript http://localhost:8010/openapi.json -o src/api.generated.ts && prettier --write src/api.generated.ts",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json index.html",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@vitejs/plugin-react": "4.4.1",
    "openapi-typescript": "7.8.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.3"
  }
}
